{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marctheshark3/agent-body-protocol/protocol/power.schema.json",
  "title": "Agent Body Protocol Power Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "kind", "ts", "voltage_v", "source", "origin", "power_w"],
  "properties": {
    "v": {"const": 1},
    "kind": {"const": "power"},
    "ts": {"type": "string", "format": "date-time"},
    "voltage_v": {"type": "number"},
    "source": {"enum": ["mains", "battery", "qi", "unknown"]},
    "origin": {"enum": ["sim", "hal"]},
    "soc_pct": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 100},
        {"type": "null"}
      ]
    },
    "charging": {"type": "boolean"},
    "docked": {"type": "boolean"},
    "low": {"type": "boolean"},
    "power_w": {
      "anyOf": [
        {"type": "number", "minimum": 0},
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source": {"const": "mains"}}, "required": ["source"]},
      "then": {"properties": {"voltage_v": {"minimum": 11.0, "maximum": 14.0}}}
    },
    {
      "if": {"properties": {"source": {"const": "battery"}}, "required": ["source"]},
      "then": {"properties": {"voltage_v": {"minimum": 9.0, "maximum": 12.6}}}
    },
    {
      "if": {"properties": {"source": {"const": "qi"}}, "required": ["source"]},
      "then": {"properties": {"voltage_v": {"minimum": 4.5, "maximum": 5.5}}}
    }
  ]
}
