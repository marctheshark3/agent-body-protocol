{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marctheshark3/agent-body-protocol/protocol/power.schema.json",
  "title": "Agent Body Protocol Power Telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "kind", "ts", "voltage_v", "source", "origin"],
  "properties": {
    "v": {"const": 1},
    "kind": {"const": "power"},
    "ts": {"type": "string", "format": "date-time"},
    "voltage_v": {"type": "number"},
    "source": {"enum": ["mains", "battery", "qi", "unknown"]},
    "origin": {"enum": ["sim", "hal"]},
    "soc_pct": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 100},
        {"type": "null"}
      ]
    },
    "charging": {"type": "boolean"},
    "docked": {"type": "boolean"},
    "low": {"type": "boolean"}
  }
}
